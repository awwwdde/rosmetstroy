# ---------- Production (docker compose) ----------
# Скопируйте в .env и заполните. Сгенерировать секреты:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Домен сайта (Caddy автоматически выпустит сертификат Let's Encrypt)
SITE_DOMAIN=rosmetstroy.ru
NEXT_PUBLIC_SITE_URL=https://rosmetstroy.ru

# PostgreSQL (порт наружу не публикуется)
POSTGRES_DB=rosmetstroy
POSTGRES_USER=rosmetstroy
POSTGRES_PASSWORD=

# Секреты приложения
SECRET_KEY=
REVALIDATE_SECRET=
COOKIE_SECURE=true

# Хранилище медиа: local — volume (docker-compose), db — PostgreSQL (единый образ на платформе), s3 — бакет
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Публичный URL бакета (для ссылок на изображения)
S3_PUBLIC_URL=

# Уведомления о заявках на e-mail (не заполнено — отключено)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
NOTIFY_EMAILS=sales@rosmetstroy.ru

# Telegram-бот панели (не заполнено — отключено). Токен — у @BotFather.
# Бот работает через long polling изнутри backend: открывать порты и задавать webhook не нужно.
# Каждый пользователь привязывает свой Telegram в «Настройках учётной записи».
# Чтобы кнопка «Войти в панель» входила без пароля: @BotFather → /setdomain → домен сайта.
TELEGRAM_BOT_TOKEN=
# Имя бота без @ (необязательно — иначе берётся из Telegram)
TELEGRAM_BOT_USERNAME=
# true — в личных уведомлениях о заявке имя, телефон, e-mail, текст и файлы; false — только номер
# и направление. Серверы Telegram за рубежом: при true укажите передачу в согласии на обработку ПД
TELEGRAM_LEAD_DETAILS=true
# Если хостинг блокирует api.telegram.org (в карточке бота «Нет связи»): прокси для запросов бота
# (http://, https://, socks5://логин:пароль@хост:порт) или свой посредник Bot API. См. docs/telegram-bot.md
TELEGRAM_PROXY=
TELEGRAM_API_URL=https://api.telegram.org
# Общий чат для короткого уведомления без персональных данных (необязательно)
TELEGRAM_CHAT_ID=
