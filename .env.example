# ---------- Production (docker compose) ----------
# Скопируйте в .env и заполните. Сгенерировать секреты:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Домен сайта (Caddy автоматически выпустит сертификат Let's Encrypt)
SITE_DOMAIN=rosmetstroy.ru
NEXT_PUBLIC_SITE_URL=https://rosmetstroy.ru

# PostgreSQL (порт наружу не публикуется)
POSTGRES_DB=rosmetstroy
POSTGRES_USER=rosmetstroy
POSTGRES_PASSWORD=

# Секреты приложения
SECRET_KEY=
REVALIDATE_SECRET=
COOKIE_SECURE=true

# Хранилище медиа: local — volume (docker-compose), db — PostgreSQL (единый образ на платформе), s3 — бакет
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Публичный URL бакета (для ссылок на изображения)
S3_PUBLIC_URL=

# Уведомления о заявках на e-mail (не заполнено — отключено)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
NOTIFY_EMAILS=sales@rosmetstroy.ru

# Уведомления в Telegram (не заполнено — отключено)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
