# Локальная разработка backend (скопируйте в back/.env)
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://rosmetstroy:rosmetstroy@localhost:5432/rosmetstroy
SITE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001
# Адрес dev-сервера Next.js для инвалидации кэша после сохранения в CMS
FRONTEND_INTERNAL_URL=http://localhost:3001
REVALIDATE_SECRET=dev-revalidate-secret
LEAD_MIN_FILL_SECONDS=3

# Администратор локальной базы создаётся командой:
#   python -m app.cli create-admin --email admin@rosmetstroy.local
